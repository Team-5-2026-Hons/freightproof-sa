# true/unset = demo mode, skips real Supabase auth
NEXT_PUBLIC_DEMO_MODE=
# Baked into the bundle at BUILD time (output: 'export' — there is no server to read it
# at runtime), so a TestFlight/APK build ships whatever was set when it was built.
# next.config.ts throws on a production build if this is unset or contains localhost.
#   deployed: NEXT_PUBLIC_API_URL=https://api.freightproof.co.za
#   local on a phone: your LAN address, e.g. http://192.168.1.5:8000
NEXT_PUBLIC_API_URL=
# Google Maps JS API key for the in-transit driving map. Optional: leaving this empty is a
# supported state — the map degrades to a coordinates card and the build still succeeds.
#
# Restricting the key (the map runs as the Maps JAVASCRIPT API in a WebView on every
# platform, so the "Android apps" key restriction — package name + SHA-1 — does NOT apply;
# that type is for the native Maps SDK). Restrict by API to "Maps JavaScript API", then by
# HTTP referrer:
#   dev      http://localhost:3001/*
#   Android  https://localhost/*   (Capacitor defaults androidScheme to https)
#   iOS      capacitor://localhost — Google's allow-list takes only http/https, so either
#            set server.iosScheme: 'https' in capacitor.config.ts, or use a second key.
# Some WebViews send no Referer header at all. A map that works in a browser but is blank
# in the APK is that: fall back to a referrer-unrestricted key with a hard quota cap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Demo only. 'true' unlocks the phone-position override on the profile screen, which
# replaces every GPS capture with a coordinate the presenter types in. A simulated fix is
# written into evidence fields with NOTHING in the ledger marking it as simulated, so the
# app shows a permanent on-screen warning while it is active. Leave this unset for any
# build whose records anyone relies on; read the header of
# lib/location/simulated-position.ts before setting it.
NEXT_PUBLIC_DEMO_GPS=
