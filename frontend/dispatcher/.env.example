# FreightProof Dispatcher — required environment variables
# Copy this file to .env.local and fill in the values.

# FastAPI backend base URL (no trailing slash)
#   deployed (Vercel, www.freightproof.co.za): https://api.freightproof.co.za
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hedera HashScan base URL (defaults to testnet if not set)
NEXT_PUBLIC_HEDERA_HASHSCAN_BASE=https://hashscan.io/testnet

# Dev-only credentials for /dev/tokens page
NEXT_PUBLIC_DEV_EMAIL=
NEXT_PUBLIC_DEV_PASSWORD=

# Gates /dev/triggers (simulated warehouse scan + Parcel Perfect events). Backend
# router is absent entirely unless DEV_PANEL_ENABLED is also set there.
NEXT_PUBLIC_DEV_PANEL=

# Raster map tile template for the precinct geofence map and list thumbnails, in the
# {z}/{x}/{y} placeholder form Leaflet consumes. Leave blank to fall back to OpenStreetMap's
# public tiles — fine for development and demos, but OSM's tile usage policy does not cover
# production, so set this to a provider with an actual usage agreement (MapTiler, Stadia,
# Carto) with its key embedded before deploying.
NEXT_PUBLIC_TILE_URL=

# Photon geocoder base URL for the precinct form's address search. Leave blank to use
# komoot's public instance (keyless, fair-use, allows search-as-you-type); set it to a
# self-hosted Photon (docker: komoot/photon) for production volumes.
NEXT_PUBLIC_GEOCODER_URL=

# Overpass API endpoint for the precinct form's "mapped shapes" outline lookup. Leave blank
# to use the public overpass-api.de instance (keyless, fair-use, rate-limited under load —
# the form falls back to a starter square when it is busy).
NEXT_PUBLIC_OVERPASS_URL=
