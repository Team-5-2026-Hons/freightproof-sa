# Public base URL of the FreightProof API (no trailing slash). Required for a production build.
NEXT_PUBLIC_API_URL=
# Optional map tile template, e.g. https://tiles.example/{z}/{x}/{y}.png. Empty uses OpenStreetMap.
NEXT_PUBLIC_TILE_URL=
# Optional Hedera topic id (e.g. 0.0.1234) FreightProof anchors to. When set, records on any other topic are flagged.
NEXT_PUBLIC_HCS_TOPIC_ID=
