    "ScanTriggerRequest": {
      "description": "Stage a warehouse scan, then ingest it through the real reconciliation path.\n\nPrecedence, most specific first:\n  - `barcodes_by_reference`: scan exactly the listed barcodes for each named\n    waybill (parcel_perfect_reference -> barcodes). A waybill absent from the\n    map stages an EMPTY scan for it, not a full one — that is how a demo\n    expresses \"this waybill was never scanned\". MockScanFeed.stage_scans\n    REPLACES prior staging rather than appending (see its docstring), so a\n    caller wanting \"everything plus one stranger barcode\" must send the full\n    list for that waybill; there is no additive mode. Per-waybill selection is\n    what lets the panel build that list correctly across several waybills at\n    one stop in a single trigger.\n  - `barcodes`: scan this literal list for every consignment at the stop,\n    which may include barcodes that are not on the manifest at all.\n  - `parcel_count`: scan the first N expected barcodes (N < expected = partial).\n  - none of the above: scan everything expected.",
      "properties": {
        "barcodes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 500,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Barcodes"
        },
        "barcodes_by_reference": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Barcodes By Reference"
        },
        "direction": {
          "$ref": "#/components/schemas/ScanDirection"
        },
        "parcel_count": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parcel Count"
        },
        "trip_id": {
          "format": "uuid",
          "title": "Trip Id",
          "type": "string"
        },
        "trip_stop_id": {
          "format": "uuid",
          "title": "Trip Stop Id",
          "type": "string"
        }
      },
      "required": [
        "trip_id",
        "trip_stop_id",
        "direction"
      ],
      "title": "ScanTriggerRequest",
      "type": "object"
    },
    "ScanTriggerResponse": {
      "properties": {
        "consignments": {
          "items": {
            "$ref": "#/components/schemas/ConsignmentScanResultRead"
