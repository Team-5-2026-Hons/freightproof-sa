# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres
# Per-instance connection pool cap. Supabase's session-mode pooler limits the whole
# project to 15 concurrent clients shared across every dev's local backend — these
# defaults (2 + 1 = 3 per instance) keep four devs running at once to 12 total, leaving
# headroom for Alembic, psql, and one-off scripts. Raise only with the team's awareness;
# it eats into a limit everyone shares.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1

# FP-275: optional API database budgets (seconds). Blank uses the code default.
# Provisional defaults: connect 10, pool wait 20, command 30, cleanup 5.
# Calibrate for the deployment; these are per-operation, not whole-request limits.
# Keep the pool wait above the longest normal connection hold (15 s Hedera/PP calls).
DB_CONNECT_TIMEOUT_SECONDS=
DB_POOL_TIMEOUT_SECONDS=
DB_COMMAND_TIMEOUT_SECONDS=
DB_CLEANUP_TIMEOUT_SECONDS=

# Throwaway Postgres for the integration suite — NEVER a Supabase project.
# tests/conftest.py runs Base.metadata.drop_all() against this URL at session
# teardown, so pointing it at a real project deletes that project's tables.
# Start it with:
#   docker compose -f infrastructure/docker/docker-compose.test.yml up -d
# Leave empty to skip the DB-backed tests (they self-skip, they don't fail).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5433/freightproof_test

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (dev only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Hedera
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=
HEDERA_SUBMIT_TIMEOUT_SECONDS=15.0

# Twilio — not yet used (no client code yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid — emails the one-time code that opens an audit pack (FP-291).
# FROM_EMAIL must be a verified sender in the SendGrid account. Empty key = emailed packs
# cannot be opened (the portal shows "try again later").
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_API_URL=https://api.sendgrid.com
SENDGRID_TIMEOUT_SECONDS=10

# Supabase Auth
# SERVICE_ROLE_KEY: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Signed evidence URLs are bearer capabilities — anyone holding one can read the
# object until it expires, so keep the lifetime short.
EVIDENCE_SIGNED_URL_TTL_SECONDS=300

# Integration mock toggles (true = use mock, false = call real API)
IDVS_USE_MOCK=true
IDVS_API_KEY=
IDVS_API_URL=
IDVS_WORKFLOW_ID=
IDVS_WEBHOOK_SECRET=
IDVS_MONTHLY_SESSION_LIMIT=500
IDVS_SESSION_TIMEOUT_SECONDS=10
IDVS_DECISION_POLL_SECONDS=90
IDVS_TOKEN_EXTENSION_MINUTES=10
IDVS_ABANDON_AFTER_SECONDS=1800
IDVS_SWEEP_INTERVAL_SECONDS=300
PULSE_USE_MOCK=true
PULSE_API_KEY=
PULSE_API_URL=
# Largest gap a Pulsit fix and the driver's own capture instant may sit apart and still
# corroborate each other. Wider than one request round trip on purpose: a parked tracker's
# OWN refresh interval can be minutes, which this codebase does not control. 300s covers a
# normal cadence while still rejecting an offline handshake replayed hours later.
PULSIT_CORROBORATION_MAX_SKEW_SECONDS=300
PP_USE_MOCK=true
PP_API_KEY=
PP_API_PASSWORD=
PP_API_TOKEN=
PP_API_URL=
PP_POLL_INTERVAL_SECONDS=60
# OpenRouteService (free Standard plan key from openrouteservice.org). Empty = no
# planned route; the driver app falls back to the trip's planned arrival time.
ORS_API_KEY=
ORS_API_URL=https://api.openrouteservice.org
ORS_TIMEOUT_SECONDS=15
ORS_SNAP_RADIUS_METRES=2000
TRIP_ROUTE_CACHE_TTL_SECONDS=86400

# Analytics chat (FP-295): the "Ask about these figures" panel on /analytics.
# Off unless AI_CHAT_ENABLED=true AND the chosen provider's key is set.
# AI_CHAT_PROVIDER: gemini (key from Google AI Studio, aistudio.google.com) or anthropic.
# AI_CHAT_MODEL must belong to that provider and be priced in
# app/integrations/ai_chat/pricing.py (e.g. gemini-3.8-flash, claude-sonnet-5-5).
# Only de-identified page totals and the typed question are sent. If the key's project has
# NO billing (free tier) Google may use them to improve its products; with billing it doesn't.
# A prepaid project stops answering when its credit runs out (top up in AI Studio).
# The budget is in USD per calendar month, all organisations together, at paid prices.
AI_CHAT_ENABLED=false
AI_CHAT_PROVIDER=gemini
AI_CHAT_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
ANTHROPIC_API_KEY=
AI_CHAT_MONTHLY_BUDGET_USD=20
# Dispatcher assistant (bottom-right helper bubble). Off unless ASSISTANT_ENABLED=true AND the
# AI_CHAT_* provider key above is set; it shares that key and the monthly budget above.
# It sends driver names and trip details to the provider, so use a key on PAID billing only.
ASSISTANT_ENABLED=false

# Runtime config
# GPS_TOLERANCE_METRES: reserved for the gate/geofence verification check —
# see feature/gps-warehouse-geofencing.
GPS_TOLERANCE_METRES=50
# Driver-vs-truck proximity check (Task 4) — driver phone fix vs Pulsit tracker fix,
# independent of GPS_TOLERANCE_METRES (which checks the truck against its precinct).
# See app/orchestration/proximity_service.py.
# Numeric fields: a BLANK value is a startup ValidationError in pydantic-settings, not
# "use the default" — so the defaults from core/config.py are spelled out here.
DRIVER_TRUCK_MAX_SEPARATION_METRES=100
DRIVER_TRUCK_MAX_FIX_AGE_SECONDS=60
DRIVER_TRUCK_MAX_SKEW_SECONDS=30
DRIVER_TRUCK_MAX_PHONE_ACCURACY_METRES=50
# Trailer-vs-horse separation before a trailer outside the precinct (while its horse is
# inside) is recorded as a decoupled trailer (TRAILER_LOCATION_MISMATCH).
TRAILER_HORSE_MAX_SEPARATION_METRES=500
DEMO_MODE=false
# HANDOVER_TOKEN_EXPIRY_MINUTES: how long a receiver capability token (FP-155) stays
# redeemable after issue.
HANDOVER_TOKEN_EXPIRY_MINUTES=10
# HANDOVER_ROTATION_SECONDS: how often the driver's on-screen QR re-issues itself (FP-237).
HANDOVER_ROTATION_SECONDS=20
# HANDOVER_RECEIVER_BASE_URL: public origin of the receiver scan app (FP-239). Must be
# reachable from a receiver's mobile data — a LAN address for local testing on a phone,
# never localhost in a deployed environment. No trailing slash.
#
# In production this must additionally be https AND share a registrable domain with this
# API: the handover binding cookie is SameSite=Strict and Secure, so a plain-HTTP origin
# never receives it and an unrelated domain never sends it back. Either failure surfaces
# as the handover's deliberately generic 404, with nothing to debug from.
#   production: HANDOVER_RECEIVER_BASE_URL=https://receiver.freightproof.co.za
# ENVIRONMENT=production refuses to start if this is loopback, plain HTTP, or empty.
HANDOVER_RECEIVER_BASE_URL=http://localhost:3002

# AUDIT_PACK_PORTAL_BASE_URL: public origin of frontend/client-portal, where insurers open
# audit-pack share links. Printed into every issued PDF.
#   production: AUDIT_PACK_PORTAL_BASE_URL=https://portal.freightproof.co.za
AUDIT_PACK_PORTAL_BASE_URL=http://localhost:3003
# Local operating time for date-bucketed reads (e.g. "today's trips"). South African
# Standard Time is UTC+2 year-round — no daylight saving to account for.
OPERATIONS_UTC_OFFSET_HOURS=2

# App
ENVIRONMENT=development
# Build version reported by GET /health and by the OpenAPI schema. Stamp this with the
# deployed tag or commit sha so /health names the build that is actually serving.
# Prefixed deliberately: a bare VERSION is a name build tooling and CI images set for
# their own reasons, and the environment outranks this file, so it would win silently.
APP_VERSION=0.1.0
# Per-dependency ceiling on the /health probes (seconds). An unreachable Postgres or Redis
# usually hangs rather than refusing, and an unbounded probe makes a degraded container
# look merely slow. Keep it well inside the orchestrator's poll interval.
HEALTH_PROBE_TIMEOUT_SECONDS=2.0
# Browser origins only — the dispatcher and (in dev) the driver PWA's web server.
#
# Do NOT add the driver app's native origins here. capacitor://localhost (iOS) and
# https://localhost (Android) are folded into the allow-list automatically by
# Settings.cors_allowed_origins, precisely because this variable REPLACES its default
# wholesale: listing them here made them deletable, and an earlier version of this file
# duly deleted them, breaking the driver app's every API call for anyone who copied it.
# The receiver app's origin is folded in the same way, from HANDOVER_RECEIVER_BASE_URL.
#
# Production example (the dispatcher's real origin, nothing else needed):
#   ALLOWED_ORIGINS=["https://www.freightproof.co.za"]
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Warehouse scan feed mock toggle (true = MockScanFeed, false = real feed)
SCAN_FEED_USE_MOCK=
# Dev trigger panel — the only switch that gates it, in every environment including
# production. Registers endpoints that fabricate warehouse scans, Parcel Perfect changes
# and exceptions. Leave blank unless a demo needs it, and blank it again afterwards.
DEV_PANEL_ENABLED=

# FP-83 driver handover: gates only NEW arrangements/replacements (blank or false = off).
# Existing pending handovers, completed-chain reads, history and recovery are unaffected.
# Enable only once the backend and the compatible driver app are released together.
DRIVER_SUBSTITUTIONS_ENABLED=

# Incidents: lets dispatchers attach documents (e.g. a SAPS case slip) to an incident
# (blank or false = off; attaching then returns 503 and the portal hides the control).
INCIDENT_DOCUMENTS_ENABLED=

# Sessions
# Minutes a session may sit idle before the API stops accepting it. Supabase refreshes
# tokens indefinitely, so without this a signed-in machine stays authenticated forever.
# Both frontends mirror this window client-side — change one, change the other
# (frontend/shared/lib/session/idle.ts).
SESSION_IDLE_TIMEOUT_MINUTES=10

# Rate limiting (budgets live in app/core/limits.py)
# Leave true everywhere but local dev and tests — it is the only volume control on the
# endpoints that spend Hedera and Parcel Perfect quota.
RATE_LIMIT_ENABLED=true
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For. Trusting that
# header without such a proxy lets any caller forge a fresh IP per request and hand
# themselves an unlimited budget.
#
# Despite the RATE_LIMIT_ prefix this now governs ALL proxy-header trust — it also decides
# whether the receiver_ip recorded on a handover confirmation is the receiver's address or
# the proxy's (app/core/client_ip.py). Behind Railway, Vercel or nginx this must be true,
# or that evidence field is wrong on every delivery and every unauthenticated caller
# shares one rate-limit bucket.
#
# ENVIRONMENT=production refuses to start unless this is set EXPLICITLY, either way:
# inheriting the default silently is not the same as deciding it.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
