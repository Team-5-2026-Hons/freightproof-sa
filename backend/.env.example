# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# Throwaway Postgres for the integration suite — NEVER a Supabase project.
# tests/conftest.py runs Base.metadata.drop_all() against this URL at session
# teardown, so pointing it at a real project deletes that project's tables.
# Start it with:
#   docker compose -f infrastructure/docker/docker-compose.test.yml up -d
# Leave empty to skip the DB-backed tests (they self-skip, they don't fail).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5433/freightproof_test

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (dev only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Hedera
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=
HEDERA_SUBMIT_TIMEOUT_SECONDS=15.0

# Twilio — not yet used (no client code yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid — not yet used (no client code yet)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Supabase Auth
# SERVICE_ROLE_KEY: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Integration mock toggles (true = use mock, false = call real API)
IDVS_USE_MOCK=true
IDVS_API_KEY=
IDVS_API_URL=
PULSE_USE_MOCK=true
PULSE_API_KEY=
PULSE_API_URL=
PP_USE_MOCK=true
PP_API_KEY=
PP_API_PASSWORD=
PP_API_TOKEN=
PP_API_URL=
PP_POLL_INTERVAL_SECONDS=60

# Runtime config
# GPS_TOLERANCE_METRES: used by the (upcoming) H1/H4 gate geofence check —
# see feature/gps-warehouse-geofencing.
GPS_TOLERANCE_METRES=50
DEMO_MODE=false

# App
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Warehouse scan feed mock toggle (true = MockScanFeed, false = real feed)
SCAN_FEED_USE_MOCK=
# Dev trigger panel (must also have ENVIRONMENT != production to activate)
DEV_PANEL_ENABLED=

# Sessions
# Minutes a session may sit idle before the API stops accepting it. Supabase refreshes
# tokens indefinitely, so without this a signed-in machine stays authenticated forever.
# Both frontends mirror this window client-side — change one, change the other
# (frontend/shared/lib/session/idle.ts).
SESSION_IDLE_TIMEOUT_MINUTES=10

# Rate limiting (budgets live in app/core/limits.py)
# Leave true everywhere but local dev and tests — it is the only volume control on the
# endpoints that spend Hedera and Parcel Perfect quota.
RATE_LIMIT_ENABLED=true
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For. Trusting that
# header without such a proxy lets any caller forge a fresh IP per request and hand
# themselves an unlimited budget.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
