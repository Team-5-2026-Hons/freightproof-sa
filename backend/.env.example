# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxx.supabase.co:5432/postgres

# Throwaway Postgres for the integration suite — NEVER a Supabase project.
# tests/conftest.py runs Base.metadata.drop_all() against this URL at session
# teardown, so pointing it at a real project deletes that project's tables.
# Start it with:
#   docker compose -f infrastructure/docker/docker-compose.test.yml up -d
# Leave empty to skip the DB-backed tests (they self-skip, they don't fail).
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5433/freightproof_test

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (dev only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Hedera
HEDERA_ACCOUNT_ID=0.0.xxxxxx
HEDERA_PRIVATE_KEY=
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=
HEDERA_SUBMIT_TIMEOUT_SECONDS=15.0

# Twilio — not yet used (no client code yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid — not yet used (no client code yet)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Supabase Auth
# SERVICE_ROLE_KEY: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Signed evidence URLs are bearer capabilities — anyone holding one can read the
# object until it expires, so keep the lifetime short.
EVIDENCE_SIGNED_URL_TTL_SECONDS=300

# Integration mock toggles (true = use mock, false = call real API)
IDVS_USE_MOCK=true
IDVS_API_KEY=
IDVS_API_URL=
PULSE_USE_MOCK=true
PULSE_API_KEY=
PULSE_API_URL=
PP_USE_MOCK=true
PP_API_KEY=
PP_API_PASSWORD=
PP_API_TOKEN=
PP_API_URL=
PP_POLL_INTERVAL_SECONDS=60

# Runtime config
# GPS_TOLERANCE_METRES: reserved for the gate/geofence verification check —
# see feature/gps-warehouse-geofencing.
GPS_TOLERANCE_METRES=50
DEMO_MODE=false
# Local operating time for date-bucketed reads (e.g. "today's trips"). South African
# Standard Time is UTC+2 year-round — no daylight saving to account for.
OPERATIONS_UTC_OFFSET_HOURS=2

# App
ENVIRONMENT=development
# Build version reported by GET /health and by the OpenAPI schema. Stamp this with the
# deployed tag or commit sha so /health names the build that is actually serving.
VERSION=0.1.0
# Per-dependency ceiling on the /health probes (seconds). An unreachable Postgres or Redis
# usually hangs rather than refusing, and an unbounded probe makes a degraded container
# look merely slow. Keep it well inside the orchestrator's poll interval.
HEALTH_PROBE_TIMEOUT_SECONDS=2.0
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Warehouse scan feed mock toggle (true = MockScanFeed, false = real feed)
SCAN_FEED_USE_MOCK=
# Dev trigger panel — the only switch that gates it, in every environment including
# production. Registers endpoints that fabricate warehouse scans, Parcel Perfect changes
# and exceptions. Leave blank unless a demo needs it, and blank it again afterwards.
DEV_PANEL_ENABLED=

# Sessions
# Minutes a session may sit idle before the API stops accepting it. Supabase refreshes
# tokens indefinitely, so without this a signed-in machine stays authenticated forever.
# Both frontends mirror this window client-side — change one, change the other
# (frontend/shared/lib/session/idle.ts).
SESSION_IDLE_TIMEOUT_MINUTES=10

# Rate limiting (budgets live in app/core/limits.py)
# Leave true everywhere but local dev and tests — it is the only volume control on the
# endpoints that spend Hedera and Parcel Perfect quota.
RATE_LIMIT_ENABLED=true
# Set true ONLY behind a reverse proxy that overwrites X-Forwarded-For. Trusting that
# header without such a proxy lets any caller forge a fresh IP per request and hand
# themselves an unlimited budget.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
