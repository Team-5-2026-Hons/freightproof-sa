{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dispatcher",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend/dispatcher"
      ],
      "port": 3000
    },
    {
      "name": "dispatcher-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend/dispatcher && exec npx next dev --port 3100"
      ],
      "port": 3100
    }
  ]
}